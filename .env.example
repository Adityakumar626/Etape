# ==============================================================================
# 🌍 Étape: Multi-Agent Travel Orchestration Engine - Environment Configuration
# ==============================================================================
# Copy this file to `.env` and populate the values below before running the app.
# Command: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM INFERENCE (Required)
# ------------------------------------------------------------------------------
# Groq Cloud API Key for ultra-fast Llama-3 / GPT-OSS inference across agent nodes.
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# ------------------------------------------------------------------------------
# 2. WEB DISCOVERY & SEARCH (Required)
# ------------------------------------------------------------------------------
# Tavily API key for real-time luxury hotel & destination intelligence queries.
# Get your key at: https://tavily.com
TAVILY_API_KEY="tvly-your_tavily_api_key_here"

# ------------------------------------------------------------------------------
# 3. STATE PERSISTENCE & CHECKPOINTING (Required)
# ------------------------------------------------------------------------------
# PostgreSQL database URI for LangGraph state checkpointing (Neon or Supabase).
# Ensure sslmode is configured (e.g., sslmode=require for Neon/Supabase poolers).
# Example: postgresql://user:password@ep-cool-db.region.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable"

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & TELEMETRY (Recommended)
# ------------------------------------------------------------------------------
# LangSmith tracing engine for tracking agent execution, latency & tokens.
# Get your key at: https://smith.langchain.com
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_your_langsmith_api_key_here"
LANGSMITH_PROJECT="Etape"

# ------------------------------------------------------------------------------
# 5. SPECIALIST TOOLS & MCP SERVERS (Optional / Live corridors & telemetry)
# ------------------------------------------------------------------------------
# AviationStack API key for real-time commercial airline corridors and schedules.
# Get your key at: https://aviationstack.com
AVIATIONSTACK_API_KEY="your_aviationstack_api_key"

# OpenWeather API key for FastMCP 5-day atmospheric weather telemetry.
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY="your_openweather_api_key"

# Default origin IATA airport code when travelers do not specify a departure hub.
DEFAULT_ORIGIN_IATA="DEL"

# ------------------------------------------------------------------------------
# 6. FRONTEND API ROUTING (For Next.js Client)
# ------------------------------------------------------------------------------
# Target URL for the FastAPI backend ASGI server.
NEXT_PUBLIC_API_URL="http://localhost:8000"
